# Copy to .env.local for local development. Never commit real values.
# In production these are set in Vercel → Settings → Environment Variables.

# Supabase (publishable key only — never the secret key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MapTiler (My Aviation Map). Public by nature: protect it in MapTiler with
# "Allowed HTTP origins" restricted to AERONOTE's domains.
NEXT_PUBLIC_MAPTILER_KEY=
